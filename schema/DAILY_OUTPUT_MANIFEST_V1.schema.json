{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ReportOps Public Daily Output Manifest V1",
  "type": "object",
  "required": [
    "schema_version",
    "output_id",
    "target_date",
    "window_start",
    "window_end",
    "product_role",
    "production_status",
    "evidence_status",
    "privacy_status",
    "report_path",
    "evidence_path",
    "created_at"
  ],
  "properties": {
    "schema_version": {"const": "REPORTOPS_PUBLIC_DAILY_OUTPUT_V1"},
    "output_id": {"type": "string"},
    "target_date": {"type": "string", "format": "date"},
    "window_start": {"type": "string"},
    "window_end": {"type": "string"},
    "product_role": {"const": "SIGNAL_RADAR"},
    "production_status": {"enum": ["CANDIDATE", "PUBLIC_CORE_ACCEPTED", "PARTIAL", "FAILED"]},
    "evidence_status": {"type": "string"},
    "privacy_status": {"enum": ["PASS_PUBLIC_SAFE", "PRIVATE_LAYER_REQUIRED", "FAIL"]},
    "report_path": {"type": "string"},
    "evidence_path": {"type": "string"},
    "source_count": {"type": "integer", "minimum": 0},
    "core_claim_count": {"type": "integer", "minimum": 0},
    "data_gaps": {"type": "array", "items": {"type": "string"}},
    "created_at": {"type": "string"}
  },
  "additionalProperties": true
}
